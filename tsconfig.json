{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "noImplicitReturns": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts"
  ]
}
